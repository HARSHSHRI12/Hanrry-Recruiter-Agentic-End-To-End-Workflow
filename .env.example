# ─────────────────────── App ──────────────────────────────────────────────────
APP_NAME=Hanrry AI Recruiter
APP_VERSION=1.0.0
DEBUG=False

# ─────────────────────── LLM ──────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here
# OPENAI_API_KEY=sk-...   # Optional fallback

# ─────────────────────── VideoSDK ─────────────────────────────────────────────
VIDEOSDK_AUTH_TOKEN=your_videosdk_auth_token_here
VIDEOSDK_AGENT_HOST=localhost
VIDEOSDK_AGENT_PORT=8081

# ─────────────────────── Database ─────────────────────────────────────────────
# SQLite (default for dev)
DATABASE_URL=sqlite:///./hanrry.db
# PostgreSQL (prod — uncomment & fill)
# DATABASE_URL=postgresql://user:password@localhost:5432/hanrry_db

# ─────────────────────── Email (Gmail SMTP) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
RECRUITER_EMAIL=recruiter@yourcompany.com

# ─────────────────────── Pinecone (Optional RAG) ──────────────────────────────
# PINECONE_API_KEY=your_pinecone_key_here
# PINECONE_INDEX_NAME=hanrry-resumes
# PINECONE_ENV=us-east-1

# ─────────────────────── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─────────────────────── Scheduler ────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata
